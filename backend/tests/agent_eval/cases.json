    {
      "id": "invalid_02_noop_candidate",
      "category": "invalid_or_incomparable",
      "scenario": "anying_basic",
      "question": "候选把网络延迟仍设为 0、没有真实变化时，能否伪装成 A/B？",
      "allowed_tools": ["get_current_scenario", "compare_scenarios"],
      "tool_call": {"tool": "compare_scenarios", "candidates": [{"label": "unchanged", "patch": {"network_delay": 0}}]},
      "expected_error": {"stage": "tool", "status": 422, "code": "no_scenario_changes"},
      "expected_evidence": ["返回 no_scenario_changes", "拒绝在无 diff 时消耗模拟预算"],
      "forbidden_claims": ["不得虚构候选提升", "不得把同一场景的重复结果称为 A/B"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "status", "op": "eq", "value": 422},
          {"path": "error.error.code", "op": "eq", "value": "no_scenario_changes"},
          {"path": "capture.scenario.scenario_hash", "op": "sha256"}
        ]
      }
    },

