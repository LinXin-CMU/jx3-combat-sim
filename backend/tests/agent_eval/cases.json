{
  "schema_version": "agent-eval-cases/v1",
  "cases": [
    {
      "id": "fact_01_current_scenario",
      "category": "fact_read",
      "scenario": "anying_basic",
      "question": "当前场景绑定的是哪个武学版本和心法？",
      "allowed_tools": ["get_current_scenario"],
      "tool_call": {"tool": "get_current_scenario"},
      "expected_evidence": ["场景摘要明确返回 2026.04 暗影千机与分山劲", "证据和快照使用同一 scenario hash"],
      "forbidden_claims": ["不得根据技能名称猜测版本", "不得声称读取了用户目录或账号信息"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.tool_name", "op": "eq", "value": "get_current_scenario"},
          {"path": "response.evidence.result.game_version", "op": "eq", "value": "2026_04_anying_qianji"},
          {"path": "response.evidence.result.mount", "op": "eq", "value": "fenshanjin"},
          {"path": "response.evidence.scenario_hash", "op": "eq_path", "value": "response.scenario.scenario_hash"},
          {"path": "response.scenario.scenario_hash", "op": "sha256"}
        ]
      }
    },
    {
      "id": "fact_02_archived_version_boundary",
      "category": "fact_read",
      "scenario": "shanhai_basic",
      "question": "归档场景是否仍明确绑定山海源流版本，而没有套用新赛季身份？",
      "allowed_tools": ["get_current_scenario"],
      "tool_call": {"tool": "get_current_scenario"},
      "expected_evidence": ["game_version 为 2025_10_shanhai_yuanliu", "mount 仍为 fenshanjin"],
      "forbidden_claims": ["不得把 2025 场景称为 2026 数据", "不得宣称归档版本具备未建模的新赛季团队数据"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.game_version", "op": "eq", "value": "2025_10_shanhai_yuanliu"},
          {"path": "response.evidence.result.mount", "op": "eq", "value": "fenshanjin"},
          {"path": "response.evidence.scenario_hash", "op": "sha256"}
        ]
      }
    },
    {
      "id": "fact_03_simulation_summary",
      "category": "fact_read",
      "scenario": "anying_basic",
      "question": "这个基础序列的模拟结果和主要技能伤害证据是什么？",
      "allowed_tools": ["get_current_scenario", "simulate_scenario"],
      "tool_call": {"tool": "simulate_scenario"},
      "expected_evidence": ["返回 DPS、总伤、fight time、skill count 与技能摘要", "所有数值绑定 fingerprint"],
      "forbidden_claims": ["不得自行计算或补写伤害", "不得把期望伤害表述为实战日志"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.dps", "op": "gt", "value": 0},
          {"path": "response.evidence.result.total_damage", "op": "gt", "value": 0},
          {"path": "response.evidence.result.skills", "op": "len_gte", "value": 1},
          {"path": "response.evidence.result.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.scenario_hash", "op": "eq_path", "value": "capture.scenario.scenario_hash"}
        ]
      }
    },
    {
      "id": "fact_04_repeatability",
      "category": "fact_read",
      "scenario": "anying_basic",
      "question": "完全相同的场景重复模拟是否产生同一份可复验证据？",
      "allowed_tools": ["get_current_scenario", "simulate_scenario"],
      "tool_call": {"tool": "simulate_scenario", "repeat": true},
      "expected_evidence": ["两次 fingerprint、DPS 和 evidence ID 相同", "trace 与耗时不参与 evidence ID"],
      "forbidden_claims": ["不得用近似相等代替确定性一致", "不得隐藏重复运行的差异"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.fingerprint_hex", "op": "eq_path", "value": "repeat_response.evidence.result.fingerprint_hex"},
          {"path": "response.evidence.result.dps", "op": "eq_path", "value": "repeat_response.evidence.result.dps"},
          {"path": "response.evidence.evidence_id", "op": "eq_path", "value": "repeat_response.evidence.evidence_id"}
        ]
      }
    },

    {
      "id": "ab_01_network_delay",
      "category": "single_variable_ab",
      "scenario": "anying_basic",
      "question": "仅把网络延迟从 0ms 改为 100ms，对该序列的 DPS 与战斗时长有什么影响？",
      "allowed_tools": ["get_current_scenario", "compare_scenarios"],
      "tool_call": {"tool": "compare_scenarios", "candidates": [{"label": "network-100ms", "patch": {"network_delay": 100}}]},
      "expected_evidence": ["显式 diff 只有 simulation.network_delay", "候选 DPS 下降且 fight time 增加"],
      "forbidden_claims": ["不得把此单场景结果推广为所有网络环境", "不得声称延迟改变技能伤害公式"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.candidates", "op": "len_eq", "value": 1},
          {"path": "response.evidence.result.candidates.0.changes.0.field", "op": "eq", "value": "simulation.network_delay"},
          {"path": "response.evidence.result.candidates.0.delta_dps", "op": "lt", "value": 0},
          {"path": "response.evidence.result.candidates.0.metrics.fight_time", "op": "gt", "value": 2.0},
          {"path": "response.evidence.result.baseline.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.metrics.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.delta_dps", "op": "approx_delta", "minuend_path": "response.evidence.result.candidates.0.metrics.dps", "subtrahend_path": "response.evidence.result.baseline.dps"}
        ]
      }
    },
    {
      "id": "ab_02_haste_level",
      "category": "single_variable_ab",
      "scenario": "anying_basic",
      "question": "仅把循环加速等级从 42087 改为 0，对该序列有什么影响？",
      "allowed_tools": ["get_current_scenario", "compare_scenarios"],
      "tool_call": {"tool": "compare_scenarios", "candidates": [{"label": "haste-zero", "patch": {"haste_level": 0}}]},
      "expected_evidence": ["显式 diff 只有 simulation.haste_level", "候选 fight time 增加且 DPS 下降"],
      "forbidden_claims": ["不得同时改动属性面板 haste_level", "不得声称这是完整加速收益曲线"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.candidates.0.changes.0.field", "op": "eq", "value": "simulation.haste_level"},
          {"path": "response.evidence.result.candidates.0.delta_dps", "op": "lt", "value": 0},
          {"path": "response.evidence.result.candidates.0.metrics.fight_time", "op": "gt", "value": 2.0},
          {"path": "response.evidence.result.baseline.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.metrics.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.delta_dps", "op": "approx_delta", "minuend_path": "response.evidence.result.candidates.0.metrics.dps", "subtrahend_path": "response.evidence.result.baseline.dps"}
        ]
      }
    },
    {
      "id": "ab_03_sequence_append",
      "category": "single_variable_ab",
      "scenario": "anying_basic",
      "question": "只在序列末尾追加一次盾击，实际执行事件和战斗时长如何变化？",
      "allowed_tools": ["get_current_scenario", "compare_scenarios"],
      "tool_call": {"tool": "compare_scenarios", "candidates": [{"label": "append-shield-strike", "patch": {"sequence": ["盾击", "盾压", "盾猛", "盾击"]}}]},
      "expected_evidence": ["显式 diff 只有 simulation.sequence", "候选 skill count 与 fight time 均增加"],
      "forbidden_claims": ["不得仅凭技能数量断言方案更优", "不得隐去触发事件也计入 skill count 的事实"],
      "pass_rule": {
        "mode": "all",
        "assertions": [
          {"path": "response.evidence.result.candidates.0.changes.0.field", "op": "eq", "value": "simulation.sequence"},
          {"path": "response.evidence.result.candidates.0.metrics.skill_count", "op": "gt", "value": 4},
          {"path": "response.evidence.result.candidates.0.metrics.fight_time", "op": "gt", "value": 2.0},
          {"path": "response.evidence.result.baseline.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.metrics.fingerprint_hex", "op": "hex16"},
          {"path": "response.evidence.result.candidates.0.delta_dps", "op": "approx_delta", "minuend_path": "response.evidence.result.candidates.0.metrics.dps", "subtrahend_path": "response.evidence.result.baseline.dps"}
        ]
      }
    },
    {
      "id": "ab_04_target_defense",
      "category": "single_variable_ab",
