          {"path": "response.timeline.result.active_event_count", "op": "gt", "value": 0},
          {"path": "response.timeline.result.triggered_event_count", "op": "gt", "value": 0},
          {"path": "response.timeline.result.fingerprint_hex", "op": "hex16"},
          {"path": "response.timeline.args.source_evidence_id", "op": "eq_path", "value": "response.simulation.evidence_id"}
        ]
      }
    },
