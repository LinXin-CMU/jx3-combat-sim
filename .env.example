# This file documents supported environment variables. The application does
# not automatically load .env files; configure them in the shell or service.
# Never put real credentials in this example file.

# Local single-process mode defaults
JX3_PORT=3005
JX3_BIND=127.0.0.1
JX3_AGENT_CONFIG=

# Router deployment mode. Leave disabled for ordinary local development.
JX3_ROUTER=
JX3_AUTH_PASSWORD=

# Worker/runtime overrides
JX3_NO_BROWSER=
JX3_USERDATA_DIR=
JX3_ICON_CACHE_DIR=
JX3_PYTHON=

# Optional read-only local knowledge snapshot. The directory must contain
# _migration-manifest.json and normalized Markdown files.
JX3_KNOWLEDGE_ROOT=
